  // OVERVIEW - Uses chunked queries to avoid 50k limit
  async function loadOverview(){
    const Xrm = getXrm();
    if(!Xrm || !Xrm.WebApi){
      showToast("Xrm.WebApi not available.");
      return;
    }
    const f = getFilters();
    
    if(!f.df || !f.dt){
      showToast("Please set date range for overview.");
      return;
    }
    // Generate chunks
    const chunks = generateDateChunks(f.df, f.dt, CFG.chunkDays);
    
    // Combine status aggregates from all chunks
    const combinedStatusMap = new Map();
    const combinedLeakageMap = new Map();
    
    for(const chunk of chunks){
      try{
        // Status aggregate for this chunk
        const fxSt = fxStatusAggChunk(f, chunk.start, chunk.end);
        const stRes = await Xrm.WebApi.retrieveMultipleRecords(CFG.service, "?fetchXml="+encodeURIComponent(fxSt));
        const stEnts = (stRes && stRes.entities) ? stRes.entities : [];
        
        for(const e of stEnts){
          const val = e.st;
          const cnt = Number(e.cnt || 0);
          const label = getFormatted(e, "st") || (val===null || val===undefined ? "" : String(val));
          const key = label || String(val||"");
          combinedStatusMap.set(key, (combinedStatusMap.get(key)||0) + cnt);
        }
        
        // Leakage reason aggregate for this chunk
        const fxLr = fxLeakageReasonAggChunk(f, chunk.start, chunk.end);
        const lrRes = await Xrm.WebApi.retrieveMultipleRecords(CFG.service, "?fetchXml="+encodeURIComponent(fxLr));
        const lrEnts = (lrRes && lrRes.entities) ? lrRes.entities : [];
        
        for(const e of lrEnts){
          const val = e.lr;
          const cnt = Number(e.cnt || 0);
          const label = getFormatted(e, "lr") || "";
          const key = String(val||"");
          if(key){
            if(!combinedLeakageMap.has(key)){
              combinedLeakageMap.set(key, { val, label, cnt: 0 });
            }
            combinedLeakageMap.get(key).cnt += cnt;
          }
        }
      }catch(e){
        // Continue with other chunks if one fails
        console.warn("Chunk query failed:", e);
      }
    }
    
    // Build status list
    const stList = [];
    for(const [label, cnt] of combinedStatusMap.entries()){
      stList.push({ val: label, label, cnt });
    }
    
    // Build leakage list
    const lrList = Array.from(combinedLeakageMap.values());
    
    // Build bucket map
    const bucketMap = new Map();
    for(const x of stList){
      const b = normalizeBucket(x.label || String(x.val||""));
      bucketMap.set(b, (bucketMap.get(b)||0) + (Number(x.cnt)||0));
    }
    svcStatusAgg = new Map();
    for(const [k,v] of bucketMap.entries()){
      svcStatusAgg.set(k, v);
    }
    renderBubbles(svcBubbles, buildSvcBubbleItems(), svcBubble, (key)=>{
      svcBubble = key;
      svcPage = 1;
      renderServicesTable();
      wireTableActions();
    });
    renderOverviewFromSvcAgg(bucketMap, stList, lrList);
  }
