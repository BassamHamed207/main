      renderVisitsTable();
    }
  });
  visNext.addEventListener("click", ()=>{
    const filtered = (visBubble==="ALL") ? visAll : visAll.filter(x=>x.visitStatus===visBubble);
    const total = filtered.length;
    const maxPage = Math.max(1, Math.ceil(total/CFG.pageSize));
    if(visPage<maxPage){
      visPage++;
      renderVisitsTable();
    }
  });
  visSortLatest.addEventListener("click", ()=>{
    visSortDir = (visSortDir==="desc" ? "asc" : "desc");
    visAll.sort((a,b)=> (visSortDir==="desc" ? (b.latest-a.latest) : (a.latest-b.latest)));
    visPage = 1;
    renderVisitsTable();
  });
  function downloadCsv(filename, rows){
    const csv = rows.map(r=>r.map(v=>{
      const s = (v ?? "").toString();
      const needs = /[",\n]/.test(s);
      const esc = s.replace(/"/g,'""');
      return needs ? `"${esc}"` : esc;
    }).join(",")).join("\n");
    const blob = new Blob([csv], {type:"text/csv;charset=utf-8"});
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(()=>URL.revokeObjectURL(url), 1500);
  }
  btnExport.addEventListener("click", ()=>{
    // Export filtered data based on current bubble selection
    const filtered = (svcBubble === "ALL") ? allSvcRows : allSvcRows.filter(r => r.bucket === svcBubble);
    
    if(!filtered.length){ 
      showToast("No data to export."); 
      return; 
    }
    const header = ["Created","Service","Doctor","Specialty","Patient","Phone","Bucket","Status","Leakage Reason","Notes","Visit"];
    const body = filtered.map(r=>[
      r.createdText,
      r.serviceName,
      r.doctor,
      r.specialty,
      r.patient,
      r.phone,
      r.bucket,
      r.statusText,
      r.leakageReasonLabel || "",
      r.notes || "",
      (r.visitName || r.visitExt || r.visitId || "")
    ]);
    downloadCsv("KSA_Services_Export.csv", [header, ...body]);
    showToast("Export ready (" + filtered.length + " rows).");
  });
  // CHART - Uses chunked queries, independent from main filters
  let trendChart=null;
  function monthKey(d){
    const y = d.getFullYear();
    const m = String(d.getMonth()+1).padStart(2,"0");
    return `${y}-${m}`;
  }
  function ensureMonths(from, to){
    const out=[];
    const a = new Date(from.getFullYear(), from.getMonth(), 1);
    const b = new Date(to.getFullYear(), to.getMonth(), 1);
    while(a<=b){
      out.push(monthKey(a));
      a.setMonth(a.getMonth()+1);
    }
    return out;
  }
  async function loadChart(){
    const Xrm = getXrm();
    if(!Xrm || !Xrm.WebApi) return showToast("Xrm.WebApi not available.");
    const cf = getChartFilters();
    if(!cf.df || !cf.dt){
      return showToast("Please set chart date range (From and To dates).");
    }
    // Generate chunks for chart
    const chunks = generateDateChunks(cf.df, cf.dt, CFG.chunkDays);
    
    // Combined results: monthKey -> { Pending, In Progress, Completed, Leaked }
    const m = new Map();
    for(const chunk of chunks){
      try{
        const fx = fxChartAggChunk(cf, chunk.start, chunk.end);
        const res = await Xrm.WebApi.retrieveMultipleRecords(CFG.service, "?fetchXml="+encodeURIComponent(fx));
        const ents = (res && res.entities) ? res.entities : [];
        for(const e of ents){
          const yy = Number(e.yy);
          const mm = Number(e.mm);
          if(!yy || !mm) continue;
          const mk = `${yy}-${String(mm).padStart(2,"0")}`;
          if(!m.has(mk)) m.set(mk, {"Pending":0,"In Progress":0,"Completed":0,"Leaked":0});
          const statusLabel = getFormatted(e, "st") || normText(e.st) || "";
          const bucket = normalizeBucket(statusLabel);
          const cnt = Number(e.cnt || 0) || 0;
          const obj = m.get(mk);
          obj[bucket] = (obj[bucket]||0) + cnt;
        }
      }catch(e){
        console.warn("Chart chunk failed:", e);
      }
    }
    
    if(m.size === 0){
      showToast("No chart data for selected filters.");
      if(trendChart){
        trendChart.destroy();
        trendChart=null;
      }
      return;
    }
    const months = ensureMonths(cf.df, cf.dt);
    const totalArr = months.map(mm=>{
      const o = m.get(mm) || {"Pending":0,"In Progress":0,"Completed":0,"Leaked":0};
      return (o["Pending"]||0) + (o["In Progress"]||0) + (o["Completed"]||0) + (o["Leaked"]||0);
    });
    const pendingArr = months.map(mm=>{
      const o = m.get(mm) || {"Pending":0,"In Progress":0,"Completed":0,"Leaked":0};
      return (o["Pending"]||0) + (o["In Progress"]||0);
    });
    const completedArr = months.map(mm=> (m.get(mm)?.["Completed"] || 0));
    const leakedArr = months.map(mm=> (m.get(mm)?.["Leaked"] || 0));
    const ds = [
      { label:"Total", data: totalArr, tension:0.25, borderColor:"#2563eb", backgroundColor:"#2563eb", pointBackgroundColor:"#2563eb", pointBorderColor:"#2563eb", borderWidth:2, pointRadius:3 },
      { label:"Leaked", data: leakedArr, tension:0.25, borderColor:"#dc2626", backgroundColor:"#dc2626", pointBackgroundColor:"#dc2626", pointBorderColor:"#dc2626", borderWidth:2, pointRadius:3 },
      { label:"Completed", data: completedArr, tension:0.25, borderColor:"#16a34a", backgroundColor:"#16a34a", pointBackgroundColor:"#16a34a", pointBorderColor:"#16a34a", borderWidth:2, pointRadius:3 },
      { label:"Pending", data: pendingArr, tension:0.25, borderColor:"#6b7280", backgroundColor:"#6b7280", pointBackgroundColor:"#6b7280", pointBorderColor:"#6b7280", borderWidth:2, pointRadius:3 }
    ];
    if(trendChart){
      trendChart.destroy();
      trendChart=null;
    }
    trendChart = new Chart(chartCanvas.getContext("2d"), {
      type:"line",
      data:{ labels: months, datasets: ds },
      options:{
        responsive:true,
        maintainAspectRatio:false,
        interaction:{ mode:"index", intersect:false },
        plugins:{ legend:{ display:true } },
        scales:{ y:{ beginAtZero:true } }
      }
    });
    showToast("Chart loaded.");
  }
  btnChart.addEventListener("click", async ()=>{
    setBusy(true,"Loading chart…");
    try{
      await loadChart();
    }finally{
      setBusy(false,"Ready");
    }
  });
  function resetFilters(){
    const now = new Date();
    // Default to today only
    dateFrom.value = toIsoDate(now);
    dateTo.value = toIsoDate(now);
    visitId.value = "";
    pname.value = "";
    pphone.value = "";
    insuranceAccount.value = "";
    subaccount.value = "";
    visitClass.value = "";
    bu.value = "";
    cat.value = "";
    spec.value = "";
    phys.value = "";
    st.value = "";
    const chartDefaultFrom = new Date(now.getFullYear(), now.getMonth() - 6, 1);
    chartLeakageReason.value = "";
    chartBU.value = "";
    chartSpec.value = "";
    chartPhys.value = "";
    chartCat.value = "";
    chartVisitClass.value = "";
    chartFrom.value = toIsoDate(chartDefaultFrom);
    chartTo.value = toIsoDate(now);
    svcSelected.clear();
    svcPage = 1;
    svcSortDir = "desc";
    svcBubble = "ALL";
    visPage = 1;
    visSortDir = "desc";
    visBubble = "ALL";
  }
  btnReset.addEventListener("click", async ()=>{
    resetFilters();
    setBusy(true,"Loading…");
    try{
      await loadLists(getFilters());
      await loadLeakageReasons();
      await applyAll();
    }finally{
      setBusy(false,"Ready");
    }
  });
  async function applyAll(){
    svcPage = Math.max(1, svcPage||1);
    visPage = Math.max(1, visPage||1);
    await loadLeakageReasons();
    await loadOverview();
    await loadServicesPage();  // This now loads all services and renders bubbles
    await loadVisits();
    wireTableActions();
  }
  btnApply.addEventListener("click", async ()=>{
    setBusy(true,"Loading…");
    try{
      svcPage = 1;
      visPage = 1;
      await loadLists(getFilters());
      await applyAll();
      showToast("Applied.");
    }finally{
      setBusy(false,"Ready");
    }
  });
  async function boot(){
    const Xrm = getXrm();
    if(!Xrm || !Xrm.WebApi){
      showToast("This page must run inside Model-driven app (Xrm not found).");
      return;
    }
    const now = new Date();
    
    // Main filters: today only by default
    dateFrom.value = toIsoDate(now);
    dateTo.value = toIsoDate(now);
    // Chart filters: 6 months back (independent)
    const chartDefaultFrom = new Date(now.getFullYear(), now.getMonth() - 6, 1);
    chartFrom.value = toIsoDate(chartDefaultFrom);
    chartTo.value = toIsoDate(now);
    setBusy(true,"Loading…");
    try{
      await loadLists(getFilters());
      await loadLeakageReasons();
      await applyAll();
    }finally{
      setBusy(false, "Ready");
    }
  }
  if(document.readyState === "loading"){
    document.addEventListener("DOMContentLoaded", boot, { once:true });
  }else{
    boot();
  }
})();
})();
</script>
