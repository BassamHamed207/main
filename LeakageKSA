  async function retrieveAllFetch(Xrm, entity, fetchXml, maxRecords = null){
    const out = [];
    let res = await Xrm.WebApi.retrieveMultipleRecords(entity, "?fetchXml=" + encodeURIComponent(fetchXml));
    if(res && res.entities && res.entities.length) out.push(...res.entities);
    while(res && res.nextLink){
      if(maxRecords && out.length >= maxRecords) break;
      const qidx = res.nextLink.indexOf("?");
      const q = qidx >= 0 ? res.nextLink.substring(qidx) : "";
      res = await Xrm.WebApi.retrieveMultipleRecords(entity, q);
      if(res && res.entities && res.entities.length) out.push(...res.entities);
