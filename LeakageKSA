  function normalizeBucket(statusLabel){
    const s = normText(statusLabel);
    const k = s.toLowerCase();
    if(!k) return "Pending";
    if(k === "complete" || k === "completed") return "Completed";
    if(k === "cancelled" || k === "canceled" || k === "discontinued" || k === "no show" || k === "noshow") return "Leaked";
    if(k === "in progress" || k === "inprogress") return "In Progress";
    if(k === "ordered") return "Pending";
    return "Pending";
  }
  function visitStatusFromCounts(cnt){
    const t = cnt.total || 0;
    const pending = cnt.pending || 0;
    const inprog = cnt.inprog || 0;
    const completed = cnt.completed || 0;
    const leaked = cnt.leaked || 0;
    if(t === 0) return "Pending";
    if(completed === t) return "Completed";
    if(leaked === t) return "Leaked";
    if(pending === t) return "Pending";
    if(leaked > 0 && (completed > 0 || pending > 0 || inprog > 0)) return "Partially Leaked";
    if(completed > 0 && (pending > 0 || inprog > 0)) return "Partially Completed";
    return "Pending";
  }
