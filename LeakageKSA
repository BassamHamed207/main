  // Generate date chunks to avoid 50k limit
  function generateDateChunks(startDate, endDate, chunkDays){
    const chunks = [];
    let current = new Date(startDate);
    
    while(current <= endDate){
      const chunkEnd = new Date(current);
      chunkEnd.setDate(chunkEnd.getDate() + chunkDays - 1);
      
      if(chunkEnd > endDate){
        chunkEnd.setTime(endDate.getTime());
      }
      
      chunks.push({
        start: new Date(current),
        end: new Date(chunkEnd.getFullYear(), chunkEnd.getMonth(), chunkEnd.getDate(), 23, 59, 59, 999)
      });
      
      current.setDate(current.getDate() + chunkDays);
    }
    
    return chunks;
  }
