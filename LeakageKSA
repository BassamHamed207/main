        byVisit.set(vid, {
          visitId: vid,
          visitName: r.visitName || "",
          visitExt: r.visitExt || "",
          patient: r.patient || "—",
          phone: r.phone || "—",
          doctor: r.doctor || "—",
          specialty: r.specialty || "—",
          latest: r.created ? r.created.getTime() : 0,
          counts: { total:0, pending:0, inprog:0, completed:0, leaked:0 }
        });
      }
      const v = byVisit.get(vid);
      const t = r.created ? r.created.getTime() : 0;
      if(t > v.latest) v.latest = t;
      v.counts.total += 1;
      if(r.bucket==="Pending") v.counts.pending += 1;
      else if(r.bucket==="In Progress") v.counts.inprog += 1;
      else if(r.bucket==="Completed") v.counts.completed += 1;
      else if(r.bucket==="Leaked") v.counts.leaked += 1;
      else v.counts.pending += 1;
    }
    const arr = Array.from(byVisit.values()).map(v=>{
      const latestText = v.latest ? new Date(v.latest).toLocaleString() : "—";
      const visitStatus = visitStatusFromCounts(v.counts);
      return { ...v, latestText, visitStatus };
