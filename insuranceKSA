function fxVisitServicesPage(visitGuid, f, page, count, orderDir){
const svc = CFG.fields.service, v = CFG.fields.visit, p = CFG.fields.patient;
const where = `<filter type="and">
<condition attribute="${svc.visitFk}" operator="eq" value="${xmlEsc(visitGuid)}" />
${f.df ? `<condition attribute="${svc.createdon}" operator="on-or-after" value="${xmlEsc(toLocalDateTime(f.df))}" />` : ""}
${f.end ? `<condition attribute="${svc.createdon}" operator="on-or-before" value="${xmlEsc(toLocalDateTime(f.end))}" />` : ""}
</filter>`;
const order = `<order attribute="${svc.createdon}" descending="${orderDir==="desc" ? "true":"false"}" />`;
return (`<fetch page="${page}" count="${count}">
<entity name="${CFG.service}">
<attribute name="${svc.id}" />
<attribute name="${svc.createdon}" />
<attribute name="${svc.approval}" />
<attribute name="${svc.svc}" />
${where}
${order}
<link-entity name="${CFG.visit}" from="${v.id}" to="${svc.visitFk}" link-type="inner" alias="v">
<attribute name="${v.name}" />
<attribute name="${v.ext}" />
<attribute name="${v.doctor}" />
<attribute name="${v.spec}" />
</link-entity>
<link-entity name="${CFG.patient}" from="${p.id}" to="${svc.patientFk}" link-type="inner" alias="p">
<attribute name="${p.name}" />
<attribute name="${p.phone}" />
</link-entity>
</entity>
</fetch>`).replace(/\s+/g," ").trim();
}
function fxVisitServicesCount(visitGuid, f){
const svc = CFG.fields.service;
return (`<fetch aggregate="true">
<entity name="${CFG.service}">
<attribute name="${svc.id}" aggregate="count" alias="cnt" />
<filter type="and">
<condition attribute="${svc.visitFk}" operator="eq" value="${xmlEsc(visitGuid)}" />
${f.df ? `<condition attribute="${svc.createdon}" operator="on-or-after" value="${xmlEsc(toLocalDateTime(f.df))}" />` : ""}
${f.end ? `<condition attribute="${svc.createdon}" operator="on-or-before" value="${xmlEsc(toLocalDateTime(f.end))}" />` : ""}
</filter>
</entity>
</fetch>`).replace(/\s+/g," ").trim();
}
