async function loadSla(Xrm){
const f = getFilters();
if(!f.df || !f.end){
const now = new Date();
f.end = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 23, 59, 59, 999);
f.df = new Date(f.end.getTime() - (30 * 86400000));
f.df.setHours(0,0,0,0);
}
const svc = CFG.fields.service, v = CFG.fields.visit, p = CFG.fields.patient, lg = CFG.fields.log;

// Normalize GUID for consistent matching
const normalizeGuid = (g) => g ? String(g).replace(/[{}]/g,"").toLowerCase() : "";

// First, fetch all services using paging (not aggregation)
const chunks = getDateChunks(f.df, f.end, CFG.chunkDays);
const allServiceRows = [];
for(const chunk of chunks){
const chunkF = {...f, df: chunk.start, end: chunk.end};
let page = 1;
let hasMore = true;
while(hasMore){
const fx = fxServicesPage(chunkF, page, 5000, "desc", "ALL");
try{
const rows = await retrieveAllFetch(Xrm, CFG.service, fx);
allServiceRows.push(...rows);
hasMore = rows.length === 5000;
page++;
if(page > 100) break;
}catch(e){ hasMore = false; }
}
}

// Build a set of service IDs for filtering log queries
const serviceIds = new Set();
for(const s of allServiceRows){
const sid = s[CFG.fields.service.id];
if(sid) serviceIds.add(normalizeGuid(sid));
}

// Fetch log records using paging (NOT aggregation) to avoid 50k limit
// Query logs for services created in the date range
const minMap = new Map();

function fxLogRecords(chunkF, pageNum){
const whereSvc = `<filter type="and">${fxServiceBaseFilters(chunkF)}</filter>`;
const vFilt = fxVisitLinkFilters(chunkF);
const pFilt = fxPatientLinkFilters(chunkF);
return (`<fetch page="${pageNum}" count="5000">
<entity name="${CFG.log}">
<attribute name="${lg.serviceLookup}" />
<attribute name="${lg.status}" />
<attribute name="${lg.dt}" />
<link-entity name="${CFG.service}" from="${svc.id}" to="${lg.serviceLookup}" link-type="inner" alias="s">
${whereSvc}
<link-entity name="${CFG.visit}" from="${v.id}" to="${svc.visitFk}" link-type="inner" alias="v">${vFilt}</link-entity>
<link-entity name="${CFG.patient}" from="${p.id}" to="${svc.patientFk}" link-type="inner" alias="p">${pFilt}</link-entity>
</link-entity>
</entity>
</fetch>`).replace(/\s+/g," ").trim();
}

// Fetch logs in chunks with paging
let totalLogRows = 0;
for(const chunk of chunks){
const chunkF = {...f, df: chunk.start, end: chunk.end};
let page = 1;
let hasMore = true;
while(hasMore){
try{
const fx = fxLogRecords(chunkF, page);
const rows = await retrieveAllFetch(Xrm, CFG.log, fx);
totalLogRows += rows.length;
if(page === 1 && rows.length > 0) {
console.log("=== SLA: Sample log record ===", rows[0]);
}
// Process each log record to find MIN timestamp per service+status
for(const r of rows){
// Lookup fields return GUID as _fieldname_value in Web API
const sidRaw = r["_" + lg.serviceLookup + "_value"] || r[lg.serviceLookup];
if(!sidRaw) continue;
const sid = normalizeGuid(sidRaw);
const statusRaw = r[lg.status];
const dtRaw = r[lg.dt];
const ns = normalizeStatus(statusRaw);
const t = msFrom(dtRaw);
if(t === null) continue;
if(!minMap.has(sid)) minMap.set(sid, { posted:null, sent:null, approved:null, rejected:null });
const o = minMap.get(sid);
if(ns==="Posted" && (o.posted===null || t < o.posted)) o.posted = t;
if(ns==="Sent" && (o.sent===null || t < o.sent)) o.sent = t;
if(ns==="Approved" && (o.approved===null || t < o.approved)) o.approved = t;
if(ns==="Rejected" && (o.rejected===null || t < o.rejected)) o.rejected = t;
}
hasMore = rows.length === 5000;
page++;
if(page > 200) break; // Safety limit
}catch(e){ 
console.warn("Log fetch error:", e.message || e);
hasMore = false; 
}
}
}
console.log("=== SLA DEBUG ===");
console.log("Total services fetched:", allServiceRows.length);
console.log("Total log rows fetched:", totalLogRows);
console.log("Unique services in minMap:", minMap.size);
console.log("Sample minMap entries:", Array.from(minMap.entries()).slice(0, 5));

if(!allServiceRows.length){
slaP2S.textContent="—"; slaS2F.textContent="—"; slaTotal.textContent="—"; slaCount.textContent="0";
tbBuckets.innerHTML = `<tr><td class="muted" colspan="3">No data</td></tr>`;
tbSlaBU.innerHTML = `<tr><td class="muted" colspan="3">No data</td></tr>`;
tbSlaSpec.innerHTML = `<tr><td class="muted" colspan="3">No data</td></tr>`;
tbSlaCat.innerHTML = `<tr><td class="muted" colspan="3">No data</td></tr>`;
return;
}
let sumP2S=0,cntP2S=0;
let sumS2F=0,cntS2F=0;
let sumTot=0,cntTot=0;
const buckets = new Map();
const dimBU = new Map(), dimSpec = new Map(), dimCat = new Map();
const addDim=(map,key,ms)=>{
if(ms===null) return;
const k=(key && String(key).trim()!=="")?String(key):"—";
if(k==="—") return;
if(!map.has(k)) map.set(k,{sum:0,cnt:0});
const o=map.get(k); o.sum+=ms; o.cnt+=1;
};
const seenIds = new Set();
let finalCount = 0; // Count of services with Approved or Rejected status

for(const s of allServiceRows){
const sidRaw = s[CFG.fields.service.id];
if(!sidRaw) continue;
const sid = normalizeGuid(sidRaw);
if(seenIds.has(sid)) continue;
seenIds.add(sid);

// Get service's current status from the approval field
const currentStatus = normalizeStatus(s[CFG.fields.service.approval]);
const hasFinalStatus = (currentStatus === "Approved" || currentStatus === "Rejected");

// Count services that have a final status (based on current service status, not log)
if(hasFinalStatus) finalCount++;

// Get service createdon as fallback for Posted (if no Posted log exists)
const serviceCreatedOn = msFrom(s[CFG.fields.service.createdon]);

const l = minMap.get(sid) || { posted:null, sent:null, approved:null, rejected:null };

// START TIME: Use Posted from log, or fall back to service createdon
const startMs = (l.posted !== null) ? l.posted : serviceCreatedOn;

// END TIME: Use Approved or Rejected timestamp from log
const endMs = (l.approved !== null) ? l.approved : l.rejected;

// Posted → Sent: Calculate if we have start time AND sent time
// (start time can be from Posted log OR service createdon)
if(startMs !== null && l.sent !== null){ 
const ms = l.sent - startMs; 
if(ms >= 0){ sumP2S += ms; cntP2S++; } 
}

// Sent → Final: sent to approved/rejected (requires both sent and final status)
if(l.sent !== null && endMs !== null){ 
const ms = endMs - l.sent; 
if(ms >= 0){ sumS2F += ms; cntS2F++; } 
}

// Total Journey (Full Journey): startMs to approved/rejected
// (start time can be from Posted log OR service createdon)
if(startMs !== null && endMs !== null){
const tot = endMs - startMs;
if(tot >= 0){
sumTot += tot; cntTot++;
const b = bucketize(tot);
if(b) buckets.set(b,(buckets.get(b)||0)+1);
addDim(dimBU, s[CFG.fields.service.bu], tot);
addDim(dimSpec, s["v."+CFG.fields.visit.spec], tot);
addDim(dimCat, s[CFG.fields.service.cat], tot);
}
}
}
console.log("=== SLA CALCULATION RESULTS ===");
console.log("P2S: count=", cntP2S, "sum=", sumP2S);
console.log("S2F: count=", cntS2F, "sum=", sumS2F);
console.log("Total: count=", cntTot, "sum=", sumTot);
console.log("Final count (Approved/Rejected):", finalCount);

slaP2S.textContent = cntP2S ? dur(sumP2S/cntP2S) : "—";
slaS2F.textContent = cntS2F ? dur(sumS2F/cntS2F) : "—";
slaTotal.textContent = cntTot ? dur(sumTot/cntTot) : "—";
slaCount.textContent = fmtInt(finalCount); // Count based on current service status
const bucketOrder = ["0–15 min","15–60 min","1–4 hrs","4–24 hrs",">24 hrs"];
const totalB = Array.from(buckets.values()).reduce((a,b)=>a+b,0);
tbBuckets.innerHTML = bucketOrder.map(k=>{
const c=buckets.get(k)||0;
return `<tr><td>${escapeHtml(k)}</td><td>${fmtInt(c)}</td><td>${pct(c,totalB)}</td></tr>`;
}).join("") || `<tr><td class="muted" colspan="3">No data</td></tr>`;
const renderDim=(map,tbody)=>{
const rows = Array.from(map.entries())
.filter(([k,v])=>v && v.cnt>0)
.sort((a,b)=>(b[1].sum/b[1].cnt)-(a[1].sum/a[1].cnt))
.slice(0, CFG.dimTop)
.map(([k,v])=>`<tr><td>${escapeHtml(k)}</td><td>${escapeHtml(dur(v.sum/v.cnt))}</td><td>${fmtInt(v.cnt)}</td></tr>`)
.join("");
tbody.innerHTML = rows || `<tr><td class="muted" colspan="3">No data</td></tr>`;
};
renderDim(dimBU, tbSlaBU);
renderDim(dimSpec, tbSlaSpec);
renderDim(dimCat, tbSlaCat);
}

function exportCSV(rows){
if(!rows.length){ showToast("No data to export."); return; }
const headers = ["Created On","Service","Doctor","Patient","Phone","Specialty","Status"];
const escapeCSV = (v)=>{ const s = (v ?? "").toString(); if(/[",\n]/.test(s)) return `"${s.replace(/"/g,'""')}"`; return s; };
const lines = [];
lines.push(headers.map(escapeCSV).join(","));
for(const r of rows){ lines.push([r.createdText,r.serviceName,r.doctor,r.patient,r.phone,r.specialty,r.statusLabel].map(escapeCSV).join(",")); }
const csv = lines.join("\n");
const blob = new Blob([csv], {type:"text/csv;charset=utf-8"});
const url = URL.createObjectURL(blob);
const a = document.createElement("a");
a.href = url;
a.download = "KSA_Insurance_Approvals_Services.csv";
document.body.appendChild(a);
a.click();
a.remove();
setTimeout(()=>URL.revokeObjectURL(url), 2000);
}

