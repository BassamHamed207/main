function applyRollingWindow(f, days) {
  const hasFrom = !!f.df;
  const hasTo   = !!f.dt;

  let start, end;

  // BOTH dates provided → use exactly what user selected (LOCAL time)
  if (hasFrom && hasTo) {
    start = new Date(f.df);
    start.setHours(0, 0, 0, 0);  // Use LOCAL midnight, not UTC

    end = new Date(f.dt);
    end.setHours(23, 59, 59, 999);  // Use LOCAL end of day
  }
  // NO dates provided → today only (LOCAL time)
  else if (!hasFrom && !hasTo) {
    const now = new Date();

    start = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 0, 0, 0, 0);
    end = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 23, 59, 59, 999);
  }
  // Only FROM date provided → use from date to from date (single day)
  else if (hasFrom) {
    start = new Date(f.df);
    start.setHours(0, 0, 0, 0);

    end = new Date(f.dt || f.df);
    end.setHours(23, 59, 59, 999);
  }
  // Only TO date provided → use to date to to date (single day)
  else if (hasTo) {
    end = new Date(f.dt);
    end.setHours(23, 59, 59, 999);  // Use LOCAL time

    start = new Date(f.df || f.dt);
    start.setHours(0, 0, 0, 0);  // Use LOCAL time
  }

  f.df = start;
  f.end = end;

  return f;
}


function getLimitedFilters() {
  const f = getFilters();

  // Only apply rolling window if user picked dates
  // For first load (df & dt null), applyRollingWindow ignores days
  applyRollingWindow(f, CFG.visitsDefaultDays);

  if (!__rollingToastShown) {
    __rollingToastShown = true;
    showToast("Visits & Services: today. Overview & SLA: full range (chunked).");
  }

  return f;
}



