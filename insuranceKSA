if(!modalVisit) return;
const f = getLimitedFilters();
const cntRows = await retrieveAllFetch(Xrm, CFG.service, fxVisitServicesCount(modalVisit.id, f));
modalTotal = cntRows.length ? Number(cntRows[0]["cnt"]||0) : 0;
const fx = fxVisitServicesPage(modalVisit.id, f, modalPage, CFG.pageSize, modalSortDir);
const rows = await retrieveAllFetch(Xrm, CFG.service, fx);
const first = rows[0] || null;
const visitName = first ? (first["v."+CFG.fields.visit.name] || "") : "";
const visitExt = first ? (first["v."+CFG.fields.visit.ext] || "") : "";
const doctorName = first ? (first["v."+CFG.fields.visit.doctor] || "—") : "—";
const specialty = first ? (first["v."+CFG.fields.visit.spec] || "—") : "—";
const patientName = first ? (first["p."+CFG.fields.patient.name] || "—") : "—";
const patientPhone = first ? (first["p."+CFG.fields.patient.phone] || "—") : "—";
pvTitle.textContent = "Visit: " + (visitName || visitExt || modalVisit.id);
pvSub.textContent = "Patient: " + patientName + " | Phone: " + patientPhone + " | Doctor: " + doctorName + " | Specialty: " + specialty;
modalVisit.patientName = patientName;
modalRows = rows.map(s=>{
const dt = s[CFG.fields.service.createdon] ? new Date(s[CFG.fields.service.createdon]) : null;
const raw = s[CFG.fields.service.approval];
const ns = normalizeStatus(raw);
return {
id: s[CFG.fields.service.id],
createdText: dt ? dt.toLocaleString() : "—",
serviceName: s[CFG.fields.service.svc] || "—",
statusLabel: ns
};
});
renderModalServices();
}
