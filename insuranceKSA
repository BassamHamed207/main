function getDateChunks(startDate, endDate, chunkDays){
const chunks = [];
const MS_DAY = 86400000;
let cur = new Date(startDate.getTime());
cur.setHours(0,0,0,0);
const finalEnd = new Date(endDate.getTime());
finalEnd.setHours(23,59,59,999);
while(cur < finalEnd){
const chunkStart = new Date(cur.getTime());
const chunkEnd = new Date(Math.min(cur.getTime() + (chunkDays * MS_DAY) - 1, finalEnd.getTime()));
chunkEnd.setHours(23,59,59,999);
chunks.push({ start: chunkStart, end: chunkEnd });
cur = new Date(chunkEnd.getTime() + 1);
}
return chunks;
}

